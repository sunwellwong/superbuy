# ---- Database (Neon serverless Postgres) ----
# Use the pooled connection string from Neon (EU Frankfurt). The app uses the
# @neondatabase/serverless HTTP driver, which is compatible with Cloudflare Pages.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---- App ----
APP_URL=https://superbuyluxe.com
# Generate with: openssl rand -base64 48
JWT_SECRET=please-change-this-to-a-long-random-string

# ---- Email (Resend) — invite codes / quote notifications to EU/US clients ----
RESEND_API_KEY=
FROM_EMAIL=invite@superbuyluxe.com

# ---- Image search ----
# CLIP embeddings run in the browser (WASM). No server-side model or object
# storage required — product images are stored as data URLs in Postgres.
